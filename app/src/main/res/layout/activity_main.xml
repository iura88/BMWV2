<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left CarPlay Vertical Dock -->
        <LinearLayout
            android:id="@+id/leftDock"
            android:layout_width="98dp"
            android:layout_height="match_parent"
            android:background="@color/bg_dock"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvDockClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="14:30"
                android:textColor="@color/text_primary"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/tvDockDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="MON, 16 NOV"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="56dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border_subtle" />

            <FrameLayout
                android:id="@+id/btnDockShortcut1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_dock_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDockShortcut1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/slot_nav_title"
                    android:src="@drawable/ic_drawer_grid" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnDockShortcut2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dock_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDockShortcut2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/slot_media_title"
                    android:src="@drawable/ic_drawer_grid" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnDockShortcut3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dock_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDockShortcut3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/slot_phone_title"
                    android:src="@drawable/ic_drawer_grid" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/btnDockModeSwitch"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_dock_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDockModeIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/header_drawer"
                    android:src="@drawable/ic_drawer_grid" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnDockSettings"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dock_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDockSettingsIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/header_settings"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_subtle" />

        <!-- Right Main Cockpit Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Top Status & Quick Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="@string/header_home"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHeaderTelemetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="GPS SEARCH  •  BT ON  •  12V ACC"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Quick Volume Down (64dp touch target) -->
                <FrameLayout
                    android:id="@+id/btnHeaderVolDown"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_dock_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volume Down"
                        android:src="@drawable/ic_vol_down" />
                </FrameLayout>

                <!-- Quick Volume Up (64dp touch target) -->
                <FrameLayout
                    android:id="@+id/btnHeaderVolUp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dock_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volume Up"
                        android:src="@drawable/ic_vol_up" />
                </FrameLayout>

                <!-- Quick Night Dim Toggle -->
                <LinearLayout
                    android:id="@+id/btnHeaderDim"
                    android:layout_width="118dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dock_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/dim_on"
                        android:src="@drawable/ic_night_dim" />

                    <TextView
                        android:id="@+id/tvHeaderDimStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"
                        android:text="@string/dim_off"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Screen Stack -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <include
                    android:id="@+id/viewHome"
                    layout="@layout/view_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/viewDrawer"
                    layout="@layout/view_drawer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <include
                    android:id="@+id/viewSettings"
                    layout="@layout/view_settings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Non-Intercepting Night Dim Filter -->
    <View
        android:id="@+id/nightDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.50"
        android:background="@color/pure_black"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Cold-Start M-Badge Splash Overlay -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pure_black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.e46.boardlauncher.ui.StripeRevealImageView
            android:id="@+id/ivSplashBadge"
            android:layout_width="320dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/m_badge" />
    </FrameLayout>

</FrameLayout>
